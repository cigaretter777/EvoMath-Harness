+def _membership_set(value: sympy.Basic) -> tuple[sympy.Symbol, sympy.Set] | None:
+    """(variable, set) for a membership answer, or None.
+
+    latex2sympy turns ``x \\in (0, 36)`` into ``Eq(x, Interval.open(0, 36))``
+    (and some parser versions keep a Contains node).  That is a membership
+    claim, not an arithmetic equality: subtracting a set from the variable
+    raises TypeError, and treating it as an unsupported expression loses a
+    correct set answer.  Only a single symbol is accepted on the variable side;
+    ``x^2 \\in S`` denotes something different and must not be graded by set
+    equality alone.
+    """
+    if isinstance(value, (sympy.Equality, sympy.Contains)):
+        lhs, rhs = value.args
+        if isinstance(lhs, sympy.Symbol) and isinstance(rhs, sympy.Set):
+            return lhs, rhs
+        if isinstance(rhs, sympy.Symbol) and isinstance(lhs, sympy.Set):
+            return rhs, lhs
+    return None
+
+
+def _sets_agree(left: sympy.Set, right: sympy.Set) -> bool | None:
+    """Prove set equality/inequality with a symmetric difference.
+
+    Returns None when SymPy cannot decide emptiness (for example a set whose
+    membership predicate it cannot evaluate); callers must then report an
+    unverifiable prediction instead of guessing.
+    """
+    if left == right:
+        return True
+    try:
+        difference = left.symmetric_difference(right)
+        empty = difference.is_empty
+    except (TypeError, ValueError, AttributeError, ArithmeticError, NotImplementedError):
+        return None
+    if empty is True:
+        return True
+    if empty is False:
+        return False
+    return None
+
+
