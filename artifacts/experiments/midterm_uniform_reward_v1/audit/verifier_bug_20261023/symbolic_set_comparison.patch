+            normalized_reference=ref_canon,
+            details={"method": method, "reason": "set comparison undecidable"},
+        )
+    return _verdict(
+        "correct" if agree else "incorrect",
+        normalized_prediction=pred_canon,
+        normalized_reference=ref_canon,
+        details={"method": method},
